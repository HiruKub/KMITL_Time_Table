{
  "manifest_version": 3,
  "name": "KMITL TIME TABLE PLUS",
  "version": "1.0",

  "description": "KMITL TIMETABLE HELPER",
  "permissions": ["storage"],

  "icons": {
    "48": "data/img/Icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "kmitl_time_table@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["https://regis.reg.kmitl.ac.th/*"],
      "js": ["script.js"],
      "run_at": "document_idle"
    }
  ]
}
